{
  "manifest_version": 3,
  "name": "Rauiri",
  "description": "Keep one browser window focused by context while stale tabs settle into Read Later.",
  "version": "0.2.6",
  "minimum_chrome_version": "121",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabGroups",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtu.be/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Rauiri",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Space"
      },
      "description": "Search workspaces"
    },
    "previous-workspace": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Switch to previous workspace"
    },
    "workspace-1": {
      "suggested_key": {
        "default": "Alt+1"
      },
      "description": "Switch to workspace 1"
    },
    "workspace-2": {
      "suggested_key": {
        "default": "Alt+2"
      },
      "description": "Switch to workspace 2"
    },
    "workspace-3": {
      "description": "Switch to workspace 3"
    },
    "workspace-4": {
      "description": "Switch to workspace 4"
    },
    "workspace-5": {
      "description": "Switch to workspace 5"
    },
    "workspace-6": {
      "description": "Switch to workspace 6"
    },
    "workspace-7": {
      "description": "Switch to workspace 7"
    },
    "workspace-8": {
      "description": "Switch to workspace 8"
    },
    "workspace-9": {
      "description": "Switch to workspace 9"
    },
    "workspace-10": {
      "description": "Switch to workspace 10 (suggested: Alt+0)"
    }
  },
  "options_page": "options/options.html"
}
