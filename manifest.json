{
  "manifest_version": 3,
  "name": "Rauiri",
  "description": "Keep one browser window focused by context while stale tabs settle into Read Later.",
  "version": "0.2.0",
  "minimum_chrome_version": "121",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtu.be/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Rauiri",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "options_page": "options/options.html"
}
